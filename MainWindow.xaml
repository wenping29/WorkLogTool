<Window x:Class="WorkLogTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WorkLogTool"
        mc:Ignorable="d"
        Title="工作日志工具" Height="820" Width="1500"
        Icon="logo.png">
    <Window.Resources>
        <local:IncrementConverter x:Key="IncrementConverter"/>
        <local:StatusToBackgroundConverter x:Key="StatusToBackgroundConverter"/>
        <local:StatusToBackgroundMultiConverter x:Key="StatusToBackgroundMultiConverter"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="730"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>
        <TabControl Grid.Row="0" Margin="0,0,0,10">
            <TabItem Header="工作记录">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="250"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10">
                        <StackPanel>
                            <TextBlock Text="日历" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                            <Calendar x:Name="Calendar" Margin="0,0,0,10" SelectionMode="SingleDate" SelectedDatesChanged="Calendar_SelectedDatesChanged"/>
                            <TextBlock Text="当日任务" FontSize="12" FontWeight="Bold" Margin="0,10,0,5"/>
                            <ListBox x:Name="TodayTaskList" Height="250" Margin="0,0,0,10">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Background="{Binding Status, Converter={StaticResource StatusToBackgroundConverter}}">
                                            <StackPanel Orientation="Horizontal" Margin="5,2">
                                                <TextBlock Text="{Binding Status}" FontWeight="Bold" Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding Content}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="添加提醒" FontSize="12" FontWeight="Bold" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal">
                                <DatePicker x:Name="QuickReminderDate" Width="100" Margin="0,0,5,5"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="QuickReminderHour" Width="45" Text="08" Margin="0,0,2,5"/>
                                <TextBlock Text=":" VerticalAlignment="Center" Margin="0,0,2,5"/>
                                <TextBox x:Name="QuickReminderMinute" Width="45" Text="00" Margin="0,0,5,5"/>
                            </StackPanel>
                            <TextBox x:Name="QuickReminderContent" AcceptsReturn="True" Height="40" Margin="0,0,0,5" Padding="2" />
                            <Button x:Name="AddQuickReminderButton" Content="添加提醒" Click="AddQuickReminderButton_Click" Width="60" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="当日工作记录" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="FilterComboBox" Width="150" SelectedIndex="0" SelectionChanged="FilterComboBox_SelectionChanged">
                                    <ComboBoxItem Content="全部记录"/>
                                    <ComboBoxItem Content="新增计划"/>
                                    <ComboBoxItem Content="未完成计划"/>
                                </ComboBox>
                            </StackPanel>
                            <DataGrid x:Name="WorkRecordDataGrid" Height="530" Margin="0,0,0,10"
                                      AutoGenerateColumns="False" IsReadOnly="False"
                                      SelectionChanged="WorkRecordDataGrid_SelectionChanged"
                                      CellEditEnding="WorkRecordDataGrid_CellEditEnding"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="Gray"
                                      AlternationCount="{Binding RelativeSource={RelativeSource Self}, Path=Items.Count}">
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="6 8"/>
                                        <Setter Property="FontSize" Value="20"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="MinHeight" Value="48"/>
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource StatusToBackgroundMultiConverter}">
                                                    <Binding Path="Status"/>
                                                    <Binding Path="EndTime"/>
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="序号" Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGridRow}, Path=AlternationIndex, Converter={StaticResource IncrementConverter}}" Width="50" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="工作内容" Binding="{Binding Content}" Width="*" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Left"/>
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="耗时" Binding="{Binding Hours}" Width="70" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="成本" Binding="{Binding Cost}" Width="70" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="状态" Width="100" IsReadOnly="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox SelectedItem="{Binding Status}" ItemsSource="{x:Static local:MainWindow.StatusValues}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" Width="80"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="进度" Width="100" IsReadOnly="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Progress, StringFormat={}{0}%}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox SelectedItem="{Binding Progress}" ItemsSource="{x:Static local:MainWindow.ProgressValues}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" Width="80"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="开始时间" Binding="{Binding StartTime, StringFormat={}{0:HH:mm}}" Width="90" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="结束时间" Binding="{Binding EndTime, StringFormat={}{0:HH:mm}}" Width="90" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button x:Name="AddWorkPlanButton" Content="添加工作计划" Margin="0,10,0,0" Click="AddWorkPlanButton_Click"/>
                            <Button x:Name="GenerateLogButton" Content="生成工作日志文件" Margin="0,10,0,0" Click="GenerateLogButton_Click"/>
                            <Button x:Name="LoadLogButton" Content="加载工作日志文件" Margin="0,10,0,0" Click="LoadLogButton_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10">
                        <StackPanel x:Name="DetailPanel">
                            <TextBlock Text="请点击左侧工作记录查看详情" FontSize="14" Foreground="Gray" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="数据可视化">
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10">
                    <StackPanel>
                        <TextBlock Text="数据可视化" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <ComboBox x:Name="ChartTypeComboBox" Margin="0,0,0,10">
                            <ComboBoxItem>折线图</ComboBoxItem>
                            <ComboBoxItem>柱状图</ComboBoxItem>
                            <ComboBoxItem>饼图</ComboBoxItem>
                            <ComboBoxItem>甘特图</ComboBoxItem>
                        </ComboBox>
                        <Button x:Name="GenerateChartButton" Content="生成图表" Margin="0,10,0,0" Click="GenerateChartButton_Click"/>
                        <Border x:Name="ChartContainer" BorderBrush="Gray" BorderThickness="1" Height="400" Margin="0,0,0,10"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="工作提醒">
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10">
                    <StackPanel>
                        <TextBlock Text="工作提醒" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                        <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Margin="0,0,0,10" Padding="10">
                            <StackPanel>
                                <TextBlock Text="早晨提醒" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                                <Button x:Name="MorningReminderButton" Content="生成今日工作提醒" Margin="0,0,0,5" Click="MorningReminderButton_Click"/>
                                <TextBlock Text="今日工作内容:" Margin="0,5,0,2"/>
                                <ListBox x:Name="TodayWorkList" Height="100" Margin="0,0,0,5"/>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Margin="0,0,0,10" Padding="10">
                            <StackPanel>
                                <TextBlock Text="添加提醒" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBlock Text="提醒日期:" Margin="0,5,0,2"/>
                                <DatePicker x:Name="ReminderDatePicker" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="HourTextBox" Width="50" Text="00" Margin="0,0,5,0"/>
                                    <TextBlock Text=":" Margin="0,0,5,0"/>
                                    <TextBox x:Name="MinuteTextBox" Width="50" Text="00"/>
                                </StackPanel>
                                <TextBlock Text="提醒内容:" Margin="0,5,0,2"/>
                                <TextBox x:Name="ReminderContent" TextWrapping="Wrap" AcceptsReturn="True" Height="100" Margin="0,0,0,10"/>
                                <Button x:Name="AddReminderButton" Content="添加提醒" Margin="0,10,0,0" Click="AddReminderButton_Click"/>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Margin="0,0,0,10" Padding="10">
                            <StackPanel>
                                <TextBlock Text="提醒列表" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                                <ListBox x:Name="ReminderList" Height="150" Margin="0,0,0,5"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="看板">
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10">
                    <StackPanel>
                        <TextBlock Text="工作看板" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="待办" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <ListBox x:Name="TodoList" Height="400" Margin="0,0,0,10" AllowDrop="True" Drop="TodoList_Drop" DragOver="ListBox_DragOver"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="进行中" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <ListBox x:Name="InProgressList" Height="400" Margin="0,0,0,10" AllowDrop="True" Drop="InProgressList_Drop" DragOver="ListBox_DragOver"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="已完成" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <ListBox x:Name="CompletedList" Height="400" Margin="0,0,0,10" AllowDrop="True" Drop="CompletedList_Drop" DragOver="ListBox_DragOver"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Button x:Name="AddKanbanItemButton" Content="添加看板项" Margin="0,10,0,0" Click="AddKanbanItemButton_Click"/>
                        <Button x:Name="UpdateCompletionButton" Content="更新完成度" Margin="0,10,0,0" Click="UpdateCompletionButton_Click"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="燃尽图">
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10">
                    <StackPanel>
                        <TextBlock Text="燃尽图" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Button x:Name="GenerateBurnDownChartButton" Content="生成燃尽图" Margin="0,10,0,0" Click="GenerateBurnDownChartButton_Click"/>
                        <Border x:Name="BurnDownChartContainer" BorderBrush="Gray" BorderThickness="1" Height="400" Margin="0,0,0,10"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="0,1,0,0" Margin="0,5,0,0">
            <ScrollViewer x:Name="StatusScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="True">
                <TextBlock x:Name="StatusText" Text="就绪" Margin="5,10"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
