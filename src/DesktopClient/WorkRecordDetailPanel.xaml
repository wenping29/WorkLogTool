<UserControl x:Class="WorkLogTool.WorkRecordDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <TextBlock x:Name="PlaceholderText" Text="请点击左侧工作记录查看详情"
                       FontSize="14" Foreground="Gray"
                       HorizontalAlignment="Center" Visibility="Collapsed"/>

            <StackPanel x:Name="EditPanel" Visibility="Collapsed">
                <TextBlock Text="工作详情" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                <TextBlock Text="工作内容:" Margin="0,0,0,5"/>
                <TextBox x:Name="ContentTextBox" TextWrapping="Wrap" Height="120"
                         AcceptsReturn="True" Margin="0,0,0,10"/>

                <TextBlock Text="日期:" Margin="0,0,0,5"/>
                <DatePicker x:Name="DatePicker" Margin="0,0,0,10"
                            DisplayDateStart="2020-01-01" DisplayDateEnd="2100-12-31"/>

                <TextBlock Text="耗时(小时):" Margin="0,0,0,5"/>
                <TextBox x:Name="HoursTextBox" Width="80" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                <TextBlock Text="成本:" Margin="0,0,0,5"/>
                <TextBox x:Name="CostTextBox" Width="80" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                <TextBlock Text="状态:" Margin="0,0,0,5"/>
                <ComboBox x:Name="StatusComboBox" Width="100" HorizontalAlignment="Left" Margin="0,0,0,10">
                    <ComboBoxItem Content="待办"/>
                    <ComboBoxItem Content="进行中"/>
                    <ComboBoxItem Content="已完成"/>
                </ComboBox>

                <TextBlock Text="进度(%):" Margin="0,0,0,5"/>
                <TextBox x:Name="ProgressTextBox" Width="80" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                <TextBlock Text="开始时间:" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  
                    <DatePicker x:Name="StartDatePicker" Width="80" Margin="0,0,10,0"/>
                    <TextBox x:Name="StartTimeTextBox" Width="80"/>
                </StackPanel>

                <TextBlock Text="结束时间:" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                 
                    <DatePicker x:Name="EndDatePicker" Width="80" Margin="0,0,10,0"/>
                    <TextBox x:Name="EndTimeTextBox" Width="80"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="SaveButton" Content="保存修改" Width="80" Margin="0,0,10,0" Click="SaveButton_Click"/>
                    <Button x:Name="DeleteButton" Content="删除" Width="60"
                             Background="LightCoral" Click="DeleteButton_Click"/>
                </StackPanel>

                <TextBlock x:Name="SubTasksCountText" Margin="0,10,0,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>